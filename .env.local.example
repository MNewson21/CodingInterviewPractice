VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Code execution backend (Piston API base URL). The public emkc endpoint is
# whitelist-only; point this at a self-hosted instance, e.g. http://localhost:2000/api/v2/piston
VITE_PISTON_URL=
# Languages to offer in the dropdown (comma-separated). Should match the runtimes
# installed on your Piston instance. Unset = all. Example: python,javascript,typescript
VITE_ENABLED_LANGUAGES=
